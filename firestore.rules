rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function conectado() {
      return request.auth != null;
    }
    function existePerfil() {
      return conectado() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function perfil() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function activo() {
      return existePerfil() && perfil().get('activo', true) == true;
    }
    function esAdmin() {
      return activo() && perfil().rol == 'admin';
    }
    function esRepartidor() {
      return activo() && perfil().rol == 'repartidor';
    }
    function esAlmacenero() {
      return activo() && perfil().rol == 'almacenero';
    }
    function esCliente() {
      return activo() && perfil().rol == 'cliente';
    }

    match /users/{uid} {
      allow create: if conectado() && (
        (request.auth.uid == uid
          && request.resource.data.rol == 'cliente'
          && request.resource.data.get('activo', true) == true
          && request.resource.data.keys().hasOnly(['nombre', 'telefono', 'direccion', 'email', 'rol', 'activo', 'creado']))
        || esAdmin()
      );
      allow read: if activo() && (request.auth.uid == uid || esAdmin());
      allow update: if esAdmin() || (
        activo()
        && request.auth.uid == uid
        && request.resource.data.rol == resource.data.rol
        && request.resource.data.get('activo', true) == resource.data.get('activo', true)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'telefono', 'direccion'])
      );
      allow delete: if esAdmin();
    }

    match /productos/{id} {
      allow read: if activo();
      allow create: if (esAdmin() || esAlmacenero())
        && request.resource.data.nombre is string
        && request.resource.data.precio is number
        && request.resource.data.precio >= 0
        && request.resource.data.existencia is int
        && request.resource.data.existencia >= 0;
      allow update: if esAdmin() || (
        esAlmacenero()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['nombre', 'categoria', 'precio', 'existencia', 'activo', 'foto'])
        && request.resource.data.precio is number
        && request.resource.data.precio >= 0
        && request.resource.data.existencia is int
        && request.resource.data.existencia >= 0
      );
      allow delete: if esAdmin();
    }

    match /pedidos/{id} {
      allow create: if esCliente()
        && request.resource.data.clienteId == request.auth.uid
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.keys().hasOnly([
          'clienteId', 'clienteNombre', 'telefono', 'direccion', 'items', 'total', 'estado', 'fecha'
        ]);

      allow read: if activo() && (
        (esCliente() && resource.data.clienteId == request.auth.uid)
        || esAdmin()
        || (esRepartidor() && (
          resource.data.estado == 'confirmado'
          || resource.data.repartidorId == request.auth.uid
        ))
      );

      // El cliente solo puede cancelar su propio pedido pendiente.
      allow update: if activo() && (
        (esCliente()
          && resource.data.clienteId == request.auth.uid
          && resource.data.estado == 'pendiente'
          && request.resource.data.estado == 'cancelado'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado']))
        ||
        (esAdmin() && (
          (resource.data.estado == 'pendiente'
            && request.resource.data.estado == 'confirmado'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'items', 'total']))
          || (resource.data.estado == 'pendiente'
            && request.resource.data.estado == 'cancelado'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado']))
          || (resource.data.estado == 'confirmado'
            && request.resource.data.estado == 'en camino'
            && request.resource.data.repartidorId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'repartidorId', 'repartidorNombre']))
          || (resource.data.estado in ['confirmado', 'en camino']
            && request.resource.data.estado == 'cancelado'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado']))
          || (resource.data.estado == 'en camino'
            && request.resource.data.estado == 'entregado'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado']))
        ))
        ||
        (esRepartidor() && (
          (resource.data.estado == 'confirmado'
            && request.resource.data.estado == 'en camino'
            && resource.data.get('repartidorId', '') == ''
            && request.resource.data.repartidorId == request.auth.uid
            && request.resource.data.repartidorNombre == perfil().nombre
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'repartidorId', 'repartidorNombre']))
          || (resource.data.estado == 'en camino'
            && resource.data.repartidorId == request.auth.uid
            && request.resource.data.estado == 'entregado'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado']))
        ))
      );

      allow delete: if esAdmin();
    }
  }
}
